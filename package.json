{
  "name": "rsdom",
  "version": "0.1.0",
  "description": "A drop-in, API-compatible fork of jsdom with a Rust core for its hot paths",
  "keywords": [
    "dom",
    "html",
    "whatwg",
    "w3c"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagiereder/rsdom.git"
  },
  "dependencies": {
    "@asamuzakjp/css-color": "^7.1.3",
    "@asamuzakjp/dom-selector": "^9.2.4",
    "@bramus/specificity": "^2.4.2",
    "@csstools/css-syntax-patches-for-csstree": "^1.1.15",
    "@exodus/bytes": "^1.16.0",
    "css-tree": "^3.2.1",
    "data-urls": "^8.0.0",
    "decimal.js": "^10.6.0",
    "html-encoding-sniffer": "^7.0.0",
    "is-potential-custom-element-name": "^1.0.1",
    "lru-cache": "^11.5.3",
    "parse5": "^8.0.1",
    "saxes": "^6.0.0",
    "tough-cookie": "^6.0.2",
    "undici": "^8.11.2",
    "w3c-xmlserializer": "^6.0.0",
    "webidl-conversions": "^8.0.1",
    "whatwg-mimetype": "^5.0.0",
    "whatwg-url": "^17.2.0",
    "xml-name-validator": "^5.0.0"
  },
  "peerDependencies": {
    "canvas": "^3.2.3"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@domenic/eslint-config": "^5.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@webref/css": "^8.7.5",
    "eslint": "^10.12.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.2",
    "mocha": "^12.0.3",
    "mocha-sugar-free": "^1.4.0",
    "npm-run-all2": "^9.0.3",
    "semver": "^7.8.5",
    "server-destroy": "^1.0.1",
    "webidl2": "^24.5.0",
    "webidl2js": "^21.0.2",
    "wireit": "^0.14.13"
  },
  "scripts": {
    "prepare": "wireit",
    "prepare:convert-idl": "wireit",
    "prepare:generate-event-sets": "wireit",
    "prepare:generate-css-style-properties": "wireit",
    "prepare:generate-js-globals": "wireit",
    "pretest": "npm run prepare && npm run wpt:init",
    "test": "npm-run-all --continue-on-error test:*",
    "test:api": "mocha tests/api/",
    "test:to-port-to-wpts": "mocha tests/to-port-to-wpts/ && mocha tests/to-port-to-wpts/level1/ && mocha tests/to-port-to-wpts/level2/ && mocha tests/to-port-to-wpts/level3/",
    "test:tuwpt": "mocha tests/web-platform-tests/run-tuwpts.js",
    "test:wpt": "mocha tests/web-platform-tests/run-wpts.js",
    "lint": "eslint --cache",
    "wpt:init": "git submodule update --init --recursive",
    "wpt:reset": "rm -rf ./tests/web-platform-tests/tests && npm run wpt:init",
    "wpt:update": "git submodule update --init --recursive --remote && cd tests/web-platform-tests/tests && python wpt.py manifest --path ../wpt-manifest.json"
  },
  "wireit": {
    "prepare": {
      "dependencies": [
        "prepare:convert-idl",
        "prepare:generate-event-sets",
        "prepare:generate-js-globals"
      ]
    },
    "prepare:convert-idl": {
      "command": "node ./scripts/webidl/convert.js",
      "dependencies": [
        "prepare:generate-css-style-properties"
      ]
    },
    "prepare:generate-event-sets": {
      "command": "node ./scripts/generate-event-sets.js"
    },
    "prepare:generate-css-style-properties": {
      "command": "node ./scripts/generate-css-style-properties.js"
    },
    "prepare:generate-js-globals": {
      "command": "node ./scripts/generate-js-globals.js"
    }
  },
  "files": [
    "src/",
    "!src/native/",
    "!src/**/*.webidl",
    "LICENSE",
    "LICENSE.txt",
    "README.md"
  ],
  "main": "./src/api.js",
  "type": "commonjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
